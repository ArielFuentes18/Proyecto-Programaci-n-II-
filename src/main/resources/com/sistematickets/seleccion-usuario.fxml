<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sistematickets.Controller.SeleccionUsuarioController"
           prefWidth="1100" prefHeight="720" minWidth="860" minHeight="620"
           styleClass="fallback" stylesheets="@css/seleccion-usuario.css">

    <MediaView fx:id="mediaView"/>
    <Region styleClass="overlay"/>

    <VBox fx:id="content" alignment="CENTER" spacing="14" styleClass="content" maxWidth="980">
        <StackPane styleClass="logo-circle" prefWidth="104" prefHeight="104" minWidth="104" minHeight="104" maxWidth="104" maxHeight="104">
            <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" fill="white" scaleX="2.6" scaleY="2.6"/>
        </StackPane>
        <Label text="SISTEMA DE VENTA DE TICKETS" styleClass="brand"/>
        <Label text="Bienvenido" styleClass="title"/>
        <Region styleClass="accent-line"/>
        <Label text="Selecciona tipo de usuario" styleClass="subtitle"/>

        <HBox alignment="CENTER" spacing="30">
            <padding><Insets top="26" bottom="14"/></padding>
                <Button fx:id="btnVendedor" onAction="#onVendedor" styleClass="role-card" contentDisplay="GRAPHIC_ONLY"
                        prefWidth="250" prefHeight="230" minWidth="200">
                    <graphic>
                        <VBox alignment="CENTER" spacing="14" prefWidth="210">
                            <StackPane styleClass="icon-bubble" prefWidth="76" prefHeight="76" minWidth="76" minHeight="76" maxWidth="76" maxHeight="76">
                                <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" fill="white" scaleX="2.0" scaleY="2.0"/>
                            </StackPane>
                            <Label text="Vendedor" styleClass="role-title"/>
                            <Label text="Registra ventas y consulta el inventario de boletos." styleClass="role-desc" wrapText="true" prefWidth="200" alignment="CENTER"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnAdmin" onAction="#onAdmin" styleClass="role-card" contentDisplay="GRAPHIC_ONLY"
                        prefWidth="250" prefHeight="230" minWidth="200">
                    <graphic>
                        <VBox alignment="CENTER" spacing="14" prefWidth="210">
                            <StackPane styleClass="icon-bubble" prefWidth="76" prefHeight="76" minWidth="76" minHeight="76" maxWidth="76" maxHeight="76">
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" fill="white" scaleX="2.0" scaleY="2.0"/>
                            </StackPane>
                            <Label text="Admin" styleClass="role-title"/>
                            <Label text="Gestiona conciertos, usuarios y reportes del sistema." styleClass="role-desc" wrapText="true" prefWidth="200" alignment="CENTER"/>
                        </VBox>
                    </graphic>
                </Button>
                <Button fx:id="btnCliente" onAction="#onCliente" styleClass="role-card" contentDisplay="GRAPHIC_ONLY"
                        prefWidth="250" prefHeight="230" minWidth="200">
                    <graphic>
                        <VBox alignment="CENTER" spacing="14" prefWidth="210">
                            <StackPane styleClass="icon-bubble" prefWidth="76" prefHeight="76" minWidth="76" minHeight="76" maxWidth="76" maxHeight="76">
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" scaleX="2.0" scaleY="2.0"/>
                            </StackPane>
                            <Label text="Cliente" styleClass="role-title"/>
                            <Label text="Explora conciertos y consulta tus compras." styleClass="role-desc" wrapText="true" prefWidth="200" alignment="CENTER"/>
                        </VBox>
                    </graphic>
                </Button>
        </HBox>

        <Label fx:id="lblEstado" styleClass="estado" text=" "/>
        <Label text="© 2026 Sistema de Venta de Tickets" styleClass="footer"/>
    </VBox>
</StackPane>
